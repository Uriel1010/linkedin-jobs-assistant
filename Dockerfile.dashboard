FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.128,<1" "uvicorn>=0.40,<1" tzdata
COPY dashboard.py dashboard_demo.py feed_rules.py i18n.py maintenance.py ./
COPY dashboard_static ./dashboard_static
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 1000:1000
CMD ["uvicorn","dashboard:app","--host","0.0.0.0","--port","8780","--no-access-log"]
