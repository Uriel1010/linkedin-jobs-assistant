FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.128,<1" "uvicorn>=0.40,<1" tzdata
COPY app.py storage.py maintenance.py collector.py source_api.py source_store.py source_providers.py email_import.py ./
ENV DATA_DIR=/app/data PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LINKEDIN_COLLECTION_ENABLED=0
USER 1000:1000
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8765","--no-access-log"]
